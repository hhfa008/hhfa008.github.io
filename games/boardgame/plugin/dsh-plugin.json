{
  "id": "boardgame-dsh-plugin",
  "name": "Boardgame DSH Plugin",
  "version": "1.0.0",
  "description": "本地桌游 HTTP/JSON API 的 dsh 工具封装：开对局、读状态、合法动作、执行动作、AI 评估。",
  "main": "index.mjs",
  "capabilities": [
    "tools",
    "http",
    "matches",
    "boardgame",
    "anonymous-device-id"
  ],
  "transport": {
    "type": "http-json",
    "baseUrl": "http://127.0.0.1:3000",
    "timeoutMs": 3000,
    "retries": 2,
    "authEnv": "BOARDGAME_API_TOKEN"
  },
  "errorCodes": {
    "E_UNKNOWN_TOOL": "Unknown tool name",
    "E_INVALID_ARGS": "Missing or invalid arguments",
    "E_HTTP": "Upstream HTTP request failed",
    "E_AUTH": "Missing or invalid bearer token"
  }
}
