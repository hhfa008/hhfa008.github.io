{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hhfa008.github.io/games/boardgame/data/boardgames.schema.json",
  "title": "BoardGame catalog",
  "description": "桌游目录 data/boardgames.json 的数组元素契约。与 types.ts 保持一致。",
  "type": "array",
  "minItems": 30,
  "maxItems": 50,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "slug",
      "name",
      "category",
      "players",
      "bestPlayers",
      "playTime",
      "weight",
      "rating",
      "designers",
      "publishers",
      "year",
      "coverUrl",
      "source"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^(gstone|bgg|manual)-[a-z0-9-]+$",
        "description": "稳定 id，例如 gstone-550"
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "description": "URL 用 kebab-case，全局唯一"
      },
      "name": {
        "type": "object",
        "additionalProperties": false,
        "required": ["zh", "en"],
        "properties": {
          "zh": { "type": "string", "minLength": 1 },
          "en": { "type": "string", "minLength": 1 }
        }
      },
      "category": {
        "type": "string",
        "enum": ["euro", "party", "ameritrash", "card", "two-player", "family"]
      },
      "players": {
        "type": "object",
        "additionalProperties": false,
        "required": ["min", "max"],
        "properties": {
          "min": { "type": "integer", "minimum": 1, "maximum": 99 },
          "max": { "type": "integer", "minimum": 1, "maximum": 99 }
        }
      },
      "bestPlayers": {
        "type": "array",
        "items": { "type": "integer", "minimum": 1, "maximum": 99 },
        "uniqueItems": true
      },
      "playTime": {
        "type": "object",
        "additionalProperties": false,
        "required": ["min", "max"],
        "properties": {
          "min": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "max": { "type": "integer", "minimum": 1, "maximum": 10000 }
        }
      },
      "weight": {
        "type": "number",
        "minimum": 1,
        "maximum": 5,
        "multipleOf": 0.1
      },
      "rating": {
        "type": "number",
        "minimum": 0,
        "maximum": 10,
        "multipleOf": 0.1
      },
      "designers": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "publishers": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "year": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 2100
      },
      "coverUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": ["site", "url", "fetchedAt"],
        "properties": {
          "site": { "type": "string", "enum": ["gstone", "bgg", "manual"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "fetchedAt": { "type": "string", "format": "date-time" }
        }
      },
      "tags": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    }
  }
}
