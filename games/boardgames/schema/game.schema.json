{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hhfa008.github.io/games/boardgames/schema/game.schema.json",
  "title": "Board game catalog entry",
  "description": "One row of games/boardgames/data/games.json. Ratings and weights are approximate snapshot values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "name",
    "nameOriginal",
    "categories",
    "playersMin",
    "playersMax",
    "bestPlayers",
    "playTimeMin",
    "playTimeMax",
    "weight",
    "rating",
    "designers",
    "publishers",
    "year",
    "cover",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "nameOriginal": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["euro", "party", "ameritrash", "card", "two-player", "family"]
      }
    },
    "playersMin": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "playersMax": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "bestPlayers": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[1-9][0-9]?(-[1-9][0-9]?)?$"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        }
      ]
    },
    "playTimeMin": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "playTimeMax": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "weight": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "rating": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 10
    },
    "designers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "publishers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "year": {
      "type": ["integer", "null"],
      "minimum": 1900,
      "maximum": 2100
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gradient", "label"],
      "properties": {
        "gradient": {
          "type": "string",
          "pattern": "^linear-gradient\\("
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "fetchedAt"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["fixture", "bgg", "gstone", "manual"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": ["string", "null"],
          "pattern": "^https://"
        },
        "fetchedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  }
}
